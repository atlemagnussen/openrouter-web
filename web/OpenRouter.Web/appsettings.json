{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Router": {
    "KeaConfigPath": "/etc/kea/kea-dhcp4.conf",
    "KeaLeasesPath": "/var/lib/kea/kea-leases4.csv",
    "KeaControlSocket": "/run/kea/kea4-ctrl-socket",
    "RadvdConfigPath": "/etc/radvd.conf",
    "NftablesConfigPath": "/etc/nftables.conf",
    "Services": [
      "kea-dhcp4-server",
      "radvd",
      "named",
      "nftables",
      "dhcpcd"
    ]
  }
}
