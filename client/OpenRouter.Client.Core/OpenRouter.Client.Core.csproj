<Project Sdk="Microsoft.NET.Sdk">

  <!-- Probes, storage and reporting shared by the netcheck command line and the desktop app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenRouter.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <!-- The same minimal DNS wire format the router app uses for its probes. -->
  <ItemGroup>
    <Compile Include="../../web/OpenRouter.Web/Probes/DnsMessage.cs" Link="Probes/DnsMessage.cs" />
  </ItemGroup>

</Project>
